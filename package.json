{
  "name": "shapemorph",
  "version": "0.1.0",
  "description": "Morphing shapes in the style of Material 3 Expressive: a shape library, smooth point-for-point morphs, springs. Framework-free core, optional React hooks, zero dependencies.",
  "license": "MIT",
  "author": "James Dominguez",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/cjs/dom.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/cjs/react.cjs"
    },
    "./shapes.css": "./dist/shapes.css",
    "./bundle": "./dist/shapemorph.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "shape",
    "morph",
    "squircle",
    "spring",
    "animation",
    "clip-path",
    "svg",
    "material-3-expressive"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesMDominguez/shapemorph.git"
  },
  "homepage": "https://github.com/JamesMDominguez/shapemorph#readme",
  "bugs": {
    "url": "https://github.com/JamesMDominguez/shapemorph/issues"
  }
}
